# Plantilla del material de firma local. Copiar como keystore.properties y
# rellenar. El archivo real (keystore.properties) y el .jks estan ignorados por
# git: nunca se versionan. Alternativa en CI: variables SEGU_STORE_FILE,
# SEGU_STORE_PASSWORD, SEGU_KEY_ALIAS y SEGU_KEY_PASSWORD.
storeFile=segu-luky-release.jks
storePassword=CAMBIAR
keyAlias=segu
keyPassword=CAMBIAR
